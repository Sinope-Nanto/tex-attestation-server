/target
**/*.rs.bk
*.pdb

# Built kernel module objects (keep the sources, drop the build output)
kmod/*.o
kmod/*.ko
kmod/*.mod
kmod/*.mod.c
kmod/.*.cmd
kmod/Module.symvers
kmod/modules.order

# Compiled test binaries (rebuilt by the test commands)
tests/test_tdx_hardware

# TPM simulator runtime state (regenerated on every start/command; see
# tpm-simu/README.md). The simulator itself - bin/, scripts/, READMEs - is
# tracked, its mutable state is not.
tpm-simu/state/tpm-simulator.pid
tpm-simu/state/*.port
tpm-simu/state/NVChip
tpm-simu/logs/*.log
tpm-simu/tpm-simulator.pid

# Stray TPM primary key context produced by manual tpm2_createprimary runs.
primary.ctx

# Runtime audit log written by the service (see src/logging.rs). The directory
# is tracked so the default location exists; its contents are not.
log/*.log
